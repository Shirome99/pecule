# Copie ce fichier en .env puis remplis les valeurs.

# Clé de signature des sessions : obligatoire en production, 32 caractères minimum.
# Génère-la avec : openssl rand -hex 32
JWT_SECRET=

# Port exposé sur la machine hôte (docker compose)
PORT=4000

# Origines autorisées à appeler l'API depuis un autre domaine (séparées par des virgules).
# Laisse vide si le front est servi par le même serveur (cas par défaut).
CORS_ORIGIN=

# Derrière un reverse proxy (nginx, Traefik, Caddy) : 1 pour lire la vraie IP du client (limitation de débit)
TRUST_PROXY=

# Fonctions IA (ticket en photo, assistant) : optionnelles, désactivées si vide.
ANTHROPIC_API_KEY=
# Modèle Claude utilisé (facultatif)
ANTHROPIC_MODEL=
