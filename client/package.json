{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "vite build && node scripts/check-bundle.mjs && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev:mobile": "vite --mode mobile",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync",
    "android": "npm run cap:sync && cap open android",
    "icons:android": "node scripts/generate-android-assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/instrument-sans": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
